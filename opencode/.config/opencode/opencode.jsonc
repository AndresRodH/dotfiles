{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["instructions/knowledge-base.md"],
  "references": {
    "kb": {
      "path": "~/Developer/obsidian-vault",
      "description": "Private Obsidian knowledge base (PARA). Use for personal ideas, plans, session captures, and living notes. Never commit vault content to work repos. Prefer knowledge-base skill + Obsidian CLI; see vault AGENTS.md."
    }
  },
  "permission": {
    "external_directory": {
      "~/Developer/obsidian-vault/**": "allow"
    },
    "bash": {
      "obsidian *": "allow"
    }
  }
}
